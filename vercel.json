{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://agentforge-ge9g.onrender.com/api/$1" },
    { "source": "/auth/(.*)", "destination": "https://agentforge-ge9g.onrender.com/auth/$1" },
    { "source": "/agent/(.*)", "destination": "https://agentforge-ge9g.onrender.com/agent/$1" },
    { "source": "/knowledge/(.*)", "destination": "https://agentforge-ge9g.onrender.com/knowledge/$1" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}